#!/usr/bin/env bash

set -euo pipefail

[ -n "${TMUX:-}" ] || exit 1

tab=$(printf '\t')
client_name=$(tmux display-message -p "#{?#{m:popup_*,#{session_name}},#{s|^popup_[a-z]+_||:session_name},#{client_name}}")
tmux list-sessions -F "#{session_id}$tab#{session_name}$tab#{s|$HOME|~|:session_path}" \
    | grep -v popup_ \
    | fzf --height=16 --with-nth=3 \
    | cut -f1 \
    | xargs tmux switch-client -c "$client_name" -t
