#!/usr/bin/env bash

set -euo pipefail

[ -n "${TMUX:-}" ] || exit 1

client_name=$(tmux display-message -p "#{client_name}")
temp_file=$(mktemp)

tmux new-session -A \
    -s "popup_yazi_$client_name" \
    "command yazi --cwd-file=$temp_file ${TMUX_POPUP_YAZI_DIR:-}" \; \
    set-hook client-detached kill-session \; \
    set-hook after-split-window kill-pane

if [ -s "$temp_file" ]; then
    yazi_dir=$(cat "$temp_file")

    if [ -d "$yazi_dir" ]; then
        tmux set-environment TMUX_POPUP_YAZI_DIR "$yazi_dir"
    fi
fi
